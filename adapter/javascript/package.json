{
  "name": "cimet-javascript-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only static JavaScript and TypeScript extraction for CIMET",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.6.2"
  }
}
